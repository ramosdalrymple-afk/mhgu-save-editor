<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MhguSave.App.App"
             xmlns:local="using:MhguSave.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#D8B976" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://MhguSave.App/Styles/HunterTheme.axaml"/>
    </Application.Styles>
</Application>
