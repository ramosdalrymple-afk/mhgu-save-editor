<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:MhguSave.App.ViewModels" xmlns:fmt="using:MhguSave.Format" xmlns:services="using:MhguSave.App.Services" xmlns:views="using:MhguSave.App.Views" x:Class="MhguSave.App.Views.MainWindow" x:DataType="vm:MainViewModel" Width="1440" Height="900" WindowStartupLocation="CenterScreen" MinWidth="1120" MinHeight="740" Title="{Binding ApplicationTitle}" Icon="/Assets/app-icon.ico" Background="#101920" FontFamily="Inter" FontSize="14" RequestedThemeVariant="Dark">
  <Window.Resources>
    <services:GameIconConverter x:Key="GameIcon"/>
    <services:RarityBrushConverter x:Key="RarityBrush"/>
    <DataTemplate x:Key="ItemCatalogRow" x:DataType="vm:ItemPick">
      <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="6" ToolTip.Tip="{Binding Display}">
        <views:GameIcon Key="{Binding IconKey}" Width="22" Height="22" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding RarityLabel}" Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}" Classes="small" VerticalAlignment="Center"/>
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Grid ColumnDefinitions="216,*" RowDefinitions="*,Auto">
    <Border Grid.RowSpan="2" BorderBrush="#394246" BorderThickness="0,0,1,0" Padding="16,20,16,16">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#1C2A32" Offset="0"/>
          <GradientStop Color="#10191F" Offset="0.65"/>
          <GradientStop Color="#242422" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid RowDefinitions="Auto,*,0,Auto">
        <StackPanel Margin="12,0,12,24" Spacing="6">
          <views:GuildEmblem Width="52" Height="52" HorizontalAlignment="Left" Margin="0,0,0,8"/>
          <TextBlock Text="MONSTER HUNTER" FontSize="10" LetterSpacing="1.6" Foreground="#B3BEC5"/>
          <TextBlock Text="GENERATIONS" FontSize="19" FontWeight="Bold" LetterSpacing="0.2"/>
          <TextBlock Text="ULTIMATE" FontSize="24" FontWeight="Bold" Foreground="#E6C990" LetterSpacing="1.2" Margin="0,-6,0,0"/>
          <Border Height="1" Background="#77664B" Margin="0,6,0,4"/>
          <TextBlock Text="SAVE EDITOR" FontSize="10" LetterSpacing="3" Foreground="#9CAEB9"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8">
          <TextBlock Text="YOUR WORKSPACE" Classes="eyebrow" Margin="14,0,0,8" FontSize="10"/>
          <ListBox Classes="nav" SelectedIndex="{Binding SelectedSection, Mode=TwoWay}" IsEnabled="{Binding IsLoaded}">
            <ListBoxItem AutomationProperties.Name="Hunter profile">
              <Grid ColumnDefinitions="30,*">
                <views:GameIcon Name="NavProfileIcon" Key="ui:profile" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Hunter profile" VerticalAlignment="Center" FontSize="13"/>
              </Grid>
            </ListBoxItem>
            <ListBoxItem AutomationProperties.Name="Item inventory">
              <Grid ColumnDefinitions="30,*">
                <views:GameIcon Name="NavInventoryIcon" Key="ui:inventory" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Item inventory" VerticalAlignment="Center" FontSize="13"/>
              </Grid>
            </ListBoxItem>
            <ListBoxItem AutomationProperties.Name="Equipment">
              <Grid ColumnDefinitions="30,*">
                <views:GameIcon Name="NavEquipmentIcon" Key="ui:equipment" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Equipment" VerticalAlignment="Center" FontSize="13"/>
              </Grid>
            </ListBoxItem>
            <ListBoxItem AutomationProperties.Name="Quest progress">
              <Grid ColumnDefinitions="30,*">
                <views:GameIcon Name="NavQuestsIcon" Key="ui:quests" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Quest progress" VerticalAlignment="Center" FontSize="13"/>
              </Grid>
            </ListBoxItem>
            <ListBoxItem AutomationProperties.Name="Unlocks &amp; rewards">
              <Grid ColumnDefinitions="30,*">
                <views:GameIcon Name="NavCollectionsIcon" Key="ui:collections" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Unlocks &amp; rewards" VerticalAlignment="Center" FontSize="13"/>
              </Grid>
            </ListBoxItem>
            <ListBoxItem AutomationProperties.Name="Loadouts">
              <Grid ColumnDefinitions="30,*"><views:GameIcon Name="NavLoadoutsIcon" Key="ui:loadouts" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Loadouts &amp; sets" FontSize="13" VerticalAlignment="Center" ToolTip.Tip="My Sets and Palico equipment sets"/></Grid>
            </ListBoxItem>
            <ListBoxItem AutomationProperties.Name="Palicoes"><Grid ColumnDefinitions="30,*"><views:GameIcon Name="NavPalicoesIcon" Key="ui:palico" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Palicoes" FontSize="13" VerticalAlignment="Center"/></Grid></ListBoxItem>
            <ListBoxItem AutomationProperties.Name="Monsters"><Grid ColumnDefinitions="30,*"><views:GameIcon Name="NavMonstersIcon" Key="ui:monsters" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Monster journal" FontSize="13" VerticalAlignment="Center"/></Grid></ListBoxItem>
          </ListBox>
        </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="3" BorderBrush="#394246" BorderThickness="0,1,0,0" Padding="10,18,4,0">
          <StackPanel Spacing="8">
            <TextBlock Text="LOCAL SAVE WORKSPACE" Classes="eyebrow" FontSize="9"/>
            <TextBlock Text="Automatic backups on save" Classes="small" TextWrapping="Wrap"/>
            <TextBlock Text="Switch · Early access" Classes="small" Foreground="#7F919D"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" Classes="workspaceContent">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <StackPanel Spacing="5">
          <TextBlock Text="HUNTER’S WORKSPACE" Classes="eyebrow" FontSize="12"/>
          <TextBlock Text="{Binding FilePath}" Classes="small" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FilePath}" HorizontalAlignment="Stretch" Margin="0,0,24,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
          <Button Content="Open save…" Click="OnOpenClick" ToolTip.Tip="Open a system or system_backup file · Ctrl+O"/>
          <Button Content="Save changes" Classes="primary" Click="OnSaveClick" IsEnabled="{Binding IsLoaded}" ToolTip.Tip="Save all characters · Ctrl+S" Name="SaveButton"/>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Classes="card workspaceSummary" IsVisible="{Binding IsLoaded}" BorderBrush="#605640">
        <Grid ColumnDefinitions="1.7*,*,*,*">
          <StackPanel Spacing="6" Margin="0,0,20,0">
            <ComboBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}" HorizontalAlignment="Stretch" Name="SelectedCharacterPicker" ToolTip.Tip="{Binding PlayTimeLine}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CharacterChoice">
                  <TextBlock Text="{Binding Label}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding RankLine}" Classes="small"/>
          </StackPanel>
          <Border Grid.Column="1" Classes="statCell">
            <StackPanel Spacing="5" VerticalAlignment="Center">
              <TextBlock Text="ITEM BOX" Classes="eyebrow" FontSize="9"/>
              <TextBlock Text="{Binding BoxStat}" Classes="stat"/>
              <TextBlock Text="Storage slots used" Classes="small statCaption"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="statCell">
            <StackPanel Spacing="5" VerticalAlignment="Center">
              <TextBlock Text="EQUIPMENT" Classes="eyebrow" FontSize="9"/>
              <TextBlock Text="{Binding EquipStat}" Classes="stat"/>
              <TextBlock Text="Pieces in your box" Classes="small statCaption"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Classes="statCell">
            <StackPanel Spacing="5" VerticalAlignment="Center">
              <TextBlock Text="QUESTS" Classes="eyebrow" FontSize="9"/>
              <TextBlock Text="{Binding QuestStat}" Classes="stat"/>
              <TextBlock Text="Unique quests cleared" Classes="small statCaption"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <TextBlock Grid.Row="2" Text="{Binding EmulatorWarning}" Foreground="#F2C777" TextWrapping="Wrap" Margin="0,0,0,12" IsVisible="{Binding EmulatorWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <Grid Grid.Row="3">
        <Grid IsVisible="{Binding IsLoaded}">
          <Grid IsVisible="{Binding IsProfileSection}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="0" HorizontalAlignment="Stretch">
                <StackPanel Spacing="5" Margin="0,0,0,18">
                  <TextBlock Text="01 / HUNTER RECORD" Classes="eyebrow" FontSize="10"/>
                  <TextBlock Text="Hunter profile" Classes="pageTitle" TextWrapping="Wrap"/>
                  <TextBlock Text="Manage your identity, currencies, and progression." Classes="muted pageDescription" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Classes="card" Padding="0" Margin="0,0,0,24" ClipToBounds="True" BorderBrush="#605640">
                  <Grid ColumnDefinitions="*,240" MinHeight="132">
                    <Grid.Background>
                      <LinearGradientBrush StartPoint="0%,100%" EndPoint="100%,0%">
                        <GradientStop Color="#202D34" Offset="0"/>
                        <GradientStop Color="#243E4A" Offset="0.65"/>
                        <GradientStop Color="#15212A" Offset="1"/>
                      </LinearGradientBrush>
                    </Grid.Background>
                    <StackPanel Margin="26,20" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="HUNTER’S GUILD · CHARACTER RECORD" Classes="eyebrow" FontSize="10"/>
                      <TextBlock Text="{Binding HunterName}" FontSize="30" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding PlayTimeLine}" Classes="muted"/>
                    </StackPanel>
                    <views:GuildEmblem Grid.Column="1" Width="156" Height="156" Opacity="0.28" Margin="0,-12,0,-12"/>
                    <Image Grid.Column="1" Source="{Binding HunterArtworkKey, Converter={StaticResource GameIcon}}" Height="132" Stretch="UniformToFill" IsVisible="{Binding HasGameVisuals}"/>
                    <Border Grid.Column="1" Background="#C0101920" Padding="8,4" VerticalAlignment="Bottom" IsVisible="{Binding HasGameVisuals}">
                      <TextBlock Text="Static artwork · not a gear preview" FontSize="9" TextAlignment="Center" Foreground="#B3BEC5"/>
                    </Border>
                    <Border Height="2" Background="#D8B976" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="104"/>
                  </Grid>
                </Border>
                <Grid ColumnDefinitions="*,24,*">
                  <StackPanel Spacing="24">
                    <Border Classes="card">
                      <StackPanel>
                        <StackPanel Spacing="16">
                          <TextBlock Text="Identity" Classes="section" TextWrapping="Wrap"/>
                          <StackPanel Spacing="6">
                            <TextBlock Text="Hunter name" Classes="label" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding HunterName, Mode=TwoWay}" MaxLength="31" Name="HunterNameInput"/>
                          </StackPanel>
                          <TextBlock Text="Up to 31 UTF-8 bytes. Names are updated in both player records." Classes="muted" TextWrapping="Wrap"/>
                          <StackPanel Spacing="6">
                            <TextBlock Text="Hunter Rank points" Classes="label" TextWrapping="Wrap"/>
                            <views:IntegerInput Value="{Binding HrPoints, Mode=TwoWay}" Minimum="0" Maximum="4294967295" Increment="1" FormatString="0" Name="HrPointsInput"/>
                            <TextBlock Text="The game calculates your displayed rank from these points." Classes="muted" TextWrapping="Wrap"/>
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Border Classes="card">
                      <StackPanel>
                        <StackPanel Spacing="14">
                          <TextBlock Text="Progression" Classes="section" TextWrapping="Wrap"/>
                          <Grid ColumnDefinitions="*,20,*">
                            <StackPanel>
                              <StackPanel Spacing="6">
                                <TextBlock Text="Village stars" Classes="label" TextWrapping="Wrap"/>
                                <views:IntegerInput Value="{Binding VillageStar, Mode=TwoWay}" Minimum="1" Maximum="10" Increment="1" FormatString="0" Name="VillageStarInput"/>
                              </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                              <StackPanel Spacing="6">
                                <TextBlock Text="Hub stars" Classes="label" TextWrapping="Wrap"/>
                                <views:IntegerInput Value="{Binding HubStar, Mode=TwoWay}" Minimum="0" Maximum="13" Increment="1" FormatString="0" Name="HubStarInput"/>
                              </StackPanel>
                            </StackPanel>
                          </Grid>
                          <TextBlock Text="Star levels and quest flags are separate. Changing stars does not complete urgent quests." Classes="muted" TextWrapping="Wrap"/>
                          <TextBlock Text="Play time · seconds" Classes="label"/>
                          <views:IntegerInput Name="PlayTimeSecondsInput" Value="{Binding PlayTimeSeconds, Mode=TwoWay}" Minimum="0" Maximum="4294967295"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="24">
                    <Border Classes="card">
                      <StackPanel>
                        <StackPanel Spacing="14">
                          <TextBlock Text="Currencies" Classes="section" TextWrapping="Wrap"/>
                          <StackPanel Spacing="6">
                            <TextBlock Text="Zenny" Classes="label" TextWrapping="Wrap"/>
                            <views:IntegerInput Value="{Binding Zenny, Mode=TwoWay}" Minimum="0" Maximum="9999999" Increment="1" FormatString="0" Name="ZennyInput"/>
                          </StackPanel>
                          <Button Content="Set maximum zenny" Command="{Binding MaxZennyCommand}" Classes="secondary"/>
                          <StackPanel Spacing="6">
                            <TextBlock Text="Wycademy points" Classes="label" TextWrapping="Wrap"/>
                            <views:IntegerInput Value="{Binding Wycademy, Mode=TwoWay}" Minimum="0" Maximum="9999999" Increment="1" FormatString="0" Name="WycademyInput"/>
                          </StackPanel>
                          <Button Content="Set maximum points" Command="{Binding MaxPointsCommand}" Classes="secondary"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Border Classes="card">
                      <StackPanel>
                        <StackPanel Spacing="14">
                          <TextBlock Text="Save workflow" Classes="section" TextWrapping="Wrap"/>
                          <TextBlock Text="Profile changes are staged as you type. For items and equipment, choose a row, edit its fields, then select Apply. Use Save changes to write all characters to disk." Classes="muted" TextWrapping="Wrap"/>
                          <TextBlock Text="A backup is created for every existing save file before writing. Close the emulator before saving." Classes="muted" TextWrapping="Wrap"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>
                <views:AppearanceView/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <Grid IsVisible="{Binding IsItemsSection}">
            <Grid RowDefinitions="Auto,*,Auto">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5" Margin="0,0,0,18">
                  <TextBlock Text="02 / ITEM STORAGE" Classes="eyebrow" FontSize="10"/>
                  <TextBlock Text="Item inventory" Classes="pageTitle" TextWrapping="Wrap"/>
                  <TextBlock Text="Search your storage, manage stacks, or add items by name." Classes="muted pageDescription" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Name="BoxToolsButton" Grid.Column="1" Content="Box tools ▾" VerticalAlignment="Top" Margin="12,0,0,0">
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuItem Header="Sort item box" Command="{Binding SortItemBoxCommand}"/>
                      <MenuItem Header="Merge box stacks" Command="{Binding MergeItemBoxCommand}"/>
                      <Separator/>
                      <MenuItem Header="Export box CSV…" Click="OnExportBoxCsvClick"/>
                      <MenuItem Header="Import box CSV replacement…" Click="OnImportBoxCsvClick"/>
                      <Separator/><MenuItem Header="Import item names…" Click="OnLoadNamesClick"/>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
              <Grid Grid.Row="1">
                <TabControl Classes="inner" Name="InventoryTabs">
                  <TabItem Header="Item box · 2,300 slots">
                    <Grid Margin="0,16,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="2*" MinWidth="360" MaxWidth="440"/></Grid.ColumnDefinitions>
                      <Grid RowDefinitions="Auto,Auto,*">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                          <TextBox Text="{Binding ItemFilter, Mode=TwoWay}" PlaceholderText="Search item name, ID, or slot…"/>
                          <CheckBox Grid.Column="1" Content="Hide empty" IsChecked="{Binding HideEmpty}" Margin="12,0,0,0"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding BoxView.Count, StringFormat='{}Shown: {0} slots'}" Classes="small" Margin="0,0,0,10"/>
                        <ListBox Grid.Row="2" ItemsSource="{Binding BoxView}" SelectedItem="{Binding SelectedBox, Mode=TwoWay}" Classes="records" Name="BoxItemsList" SelectionChanged="OnInventorySlotSelected">
                          <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ItemRow">
                              <Grid ColumnDefinitions="38,36,*,56" Margin="2,6">
                                <Image Source="{Binding IconKey, Converter={StaticResource GameIcon}}" Width="30" Height="30" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding SlotNumber}" Classes="small" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" Margin="0,0,12,0">
                                  <TextBlock Text="{Binding Name}" Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                  <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding Id, StringFormat='ID {0}'}" Classes="small"/><TextBlock Text="{Binding RarityLabel}" Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}" Classes="small"/></StackPanel>
                                </StackPanel>
                                <Border Grid.Column="3" Background="#22323C" CornerRadius="4" Padding="7,4" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding Count, StringFormat='× {0}'}" FontWeight="Medium"/></Border>
                              </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                      </Grid>
                      <Border Grid.Column="2" Classes="card editorCard">
                        <TabControl Name="BoxEditorTabs" Classes="inner">
                          <TabItem Header="Edit slot">
                            <Grid RowDefinitions="*,Auto" Classes="inputForm" Margin="0,16,0,0">
                              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="20" Margin="0,0,8,0">
                                  <StackPanel Spacing="6"><TextBlock Text="Edit item" Classes="section"/><TextBlock Text="Choose a slot, then edit its contents." Classes="small" TextWrapping="Wrap"/></StackPanel>
                                  <Border Classes="inset"><Grid ColumnDefinitions="40,*">
                                      <views:GameIcon Key="{Binding SelectedBox.IconKey}" Width="30" Height="30" VerticalAlignment="Center"/>
                                      <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding SelectedBox.Name, FallbackValue=Select an item from the list, TargetNullValue=Select an item from the list}" Foreground="{Binding SelectedBox.Rarity, Converter={StaticResource RarityBrush}}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedBox.RarityLabel}" Classes="small"/></StackPanel>
                                    </Grid></Border>
                                  <Grid ColumnDefinitions="*,16,*" IsEnabled="{Binding HasBoxSelection}">
                                    <StackPanel Spacing="8"><TextBlock Text="Item ID" Classes="label"/><views:IntegerInput Value="{Binding EditBoxId, Mode=TwoWay}" Minimum="0" Maximum="4095" FormatString="0" Name="EditBoxIdInput"/></StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="8"><TextBlock Text="Quantity" Classes="label"/><views:IntegerInput Value="{Binding EditBoxCount, Mode=TwoWay}" Minimum="0" Maximum="127" FormatString="0" Name="EditBoxCountInput"/></StackPanel>
                                  </Grid>
                                  <TextBlock Text="Apply stages this slot. Save changes writes it to disk." Classes="small" TextWrapping="Wrap"/>
                                </StackPanel>
                              </ScrollViewer>
                              <Border Grid.Row="1" Classes="actionBar"><WrapPanel>
                                  <views:ValidatedButton Content="Apply to slot" Command="{Binding ApplySelectedBoxCommand}" Classes="primary" IsEnabled="{Binding HasBoxSelection}"/>
                                  <Button Content="Clear slot" Command="{Binding ClearSelectedBoxCommand}" Classes="danger" IsEnabled="{Binding HasBoxSelection}"/>
                                </WrapPanel></Border>
                            </Grid>
                          </TabItem>
                          <TabItem Header="Add item">
                            <Grid RowDefinitions="Auto,*,Auto,Auto" Classes="inputForm" Tag="CreationDraft" Margin="0,12,0,0">
                              <TextBox Text="{Binding ItemNameQuery, Mode=TwoWay}" PlaceholderText="Search by item name or ID…" Name="BoxItemSearchInput"/>
                              <Grid Grid.Row="1" Margin="0,8,0,0" ClipToBounds="True">
                                <ListBox ItemsSource="{Binding ItemNameMatches}" SelectedItem="{Binding SelectedItemPick, Mode=TwoWay}" ItemTemplate="{StaticResource ItemCatalogRow}" Classes="records" Name="BoxItemCatalogList"/>
                                <TextBlock Text="{Binding ItemSearchHint}" IsVisible="{Binding HasNoItemMatches}" Classes="small" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0" IsHitTestVisible="False"/>
                              </Grid>
                              <Grid Grid.Row="2" ColumnDefinitions="*,16,*" Margin="0,12,0,0">
                                <StackPanel Spacing="6">
                                  <TextBlock Text="Item ID" Classes="label"/>
                                  <views:IntegerInput Value="{Binding AddItemId, Mode=TwoWay}" Minimum="1" Maximum="4095" FormatString="0" Name="AddBoxIdInput"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                  <TextBlock Text="Quantity" Classes="label"/>
                                  <views:IntegerInput Value="{Binding AddItemCount, Mode=TwoWay}" Minimum="1" Maximum="127" FormatString="0" Name="AddBoxCountInput"/>
                                </StackPanel>
                              </Grid>
                              <Border Grid.Row="3" Classes="actionBar inventoryAction">
                                <views:ValidatedButton HorizontalAlignment="Stretch" Content="Add to item box" Command="{Binding AddToBoxCommand}" Classes="primary" Name="AddBoxItemButton" ToolTip.Tip="Adds to the first empty slot"/>
                              </Border>
                            </Grid>
                          </TabItem>
                        </TabControl>
                      </Border>
                    </Grid>
                  </TabItem>
                  <TabItem Header="Pouch · 32 slots">
                    <Grid Margin="0,16,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="2*" MinWidth="360" MaxWidth="440"/></Grid.ColumnDefinitions>
                      <Grid RowDefinitions="Auto,Auto,*">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                          <TextBox Text="{Binding ItemFilter, Mode=TwoWay}" PlaceholderText="Search item name, ID, or slot…"/>
                          <CheckBox Grid.Column="1" Content="Hide empty" IsChecked="{Binding HideEmpty}" Margin="12,0,0,0"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding PouchView.Count, StringFormat='{}Shown: {0} slots'}" Classes="small" Margin="0,0,0,10"/>
                        <ListBox Grid.Row="2" ItemsSource="{Binding PouchView}" SelectedItem="{Binding SelectedPouch, Mode=TwoWay}" Classes="records" Name="PouchItemsList" SelectionChanged="OnInventorySlotSelected">
                          <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ItemRow">
                              <Grid ColumnDefinitions="38,36,*,56" Margin="2,6">
                                <Image Source="{Binding IconKey, Converter={StaticResource GameIcon}}" Width="30" Height="30" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding SlotNumber}" Classes="small" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" Margin="0,0,12,0">
                                  <TextBlock Text="{Binding Name}" Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                  <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding Id, StringFormat='ID {0}'}" Classes="small"/><TextBlock Text="{Binding RarityLabel}" Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}" Classes="small"/></StackPanel>
                                </StackPanel>
                                <Border Grid.Column="3" Background="#22323C" CornerRadius="4" Padding="7,4" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding Count, StringFormat='× {0}'}" FontWeight="Medium"/></Border>
                              </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                      </Grid>
                      <Border Grid.Column="2" Classes="card editorCard">
                        <TabControl Name="PouchEditorTabs" Classes="inner">
                          <TabItem Header="Edit slot">
                            <Grid RowDefinitions="*,Auto" Classes="inputForm" Margin="0,16,0,0">
                              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="20" Margin="0,0,8,0">
                                  <StackPanel Spacing="6"><TextBlock Text="Edit item" Classes="section"/><TextBlock Text="Choose a slot, then edit its contents." Classes="small" TextWrapping="Wrap"/></StackPanel>
                                  <Border Classes="inset"><Grid ColumnDefinitions="40,*">
                                      <views:GameIcon Key="{Binding SelectedPouch.IconKey}" Width="30" Height="30" VerticalAlignment="Center"/>
                                      <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding SelectedPouch.Name, FallbackValue=Select an item from the list, TargetNullValue=Select an item from the list}" Foreground="{Binding SelectedPouch.Rarity, Converter={StaticResource RarityBrush}}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedPouch.RarityLabel}" Classes="small"/></StackPanel>
                                    </Grid></Border>
                                  <Grid ColumnDefinitions="*,16,*" IsEnabled="{Binding HasPouchSelection}">
                                    <StackPanel Spacing="8"><TextBlock Text="Item ID" Classes="label"/><views:IntegerInput Value="{Binding EditPouchId, Mode=TwoWay}" Minimum="0" Maximum="4095" FormatString="0" Name="EditPouchIdInput"/></StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="8"><TextBlock Text="Quantity" Classes="label"/><views:IntegerInput Value="{Binding EditPouchCount, Mode=TwoWay}" Minimum="0" Maximum="127" FormatString="0" Name="EditPouchCountInput"/></StackPanel>
                                  </Grid>
                                  <TextBlock Text="Apply stages this slot. Save changes writes it to disk." Classes="small" TextWrapping="Wrap"/>
                                </StackPanel>
                              </ScrollViewer>
                              <Border Grid.Row="1" Classes="actionBar"><WrapPanel>
                                  <views:ValidatedButton Content="Apply to slot" Command="{Binding ApplySelectedPouchCommand}" Classes="primary" IsEnabled="{Binding HasPouchSelection}"/>
                                  <Button Content="Clear slot" Command="{Binding ClearSelectedPouchCommand}" Classes="danger" IsEnabled="{Binding HasPouchSelection}"/>
                                </WrapPanel></Border>
                            </Grid>
                          </TabItem>
                          <TabItem Header="Add item">
                            <Grid RowDefinitions="Auto,*,Auto,Auto" Classes="inputForm" Tag="CreationDraft" Margin="0,12,0,0">
                              <TextBox Text="{Binding ItemNameQuery, Mode=TwoWay}" PlaceholderText="Search by item name or ID…" Name="PouchItemSearchInput"/>
                              <Grid Grid.Row="1" Margin="0,8,0,0" ClipToBounds="True">
                                <ListBox ItemsSource="{Binding ItemNameMatches}" SelectedItem="{Binding SelectedItemPick, Mode=TwoWay}" ItemTemplate="{StaticResource ItemCatalogRow}" Classes="records" Name="PouchItemCatalogList"/>
                                <TextBlock Text="{Binding ItemSearchHint}" IsVisible="{Binding HasNoItemMatches}" Classes="small" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0" IsHitTestVisible="False"/>
                              </Grid>
                              <Grid Grid.Row="2" ColumnDefinitions="*,16,*" Margin="0,12,0,0">
                                <StackPanel Spacing="6">
                                  <TextBlock Text="Item ID" Classes="label"/>
                                  <views:IntegerInput Value="{Binding AddItemId, Mode=TwoWay}" Minimum="1" Maximum="4095" FormatString="0" Name="AddPouchIdInput"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                  <TextBlock Text="Quantity" Classes="label"/>
                                  <views:IntegerInput Value="{Binding AddItemCount, Mode=TwoWay}" Minimum="1" Maximum="127" FormatString="0" Name="AddPouchCountInput"/>
                                </StackPanel>
                              </Grid>
                              <Border Grid.Row="3" Classes="actionBar inventoryAction">
                                <views:ValidatedButton HorizontalAlignment="Stretch" Content="Add to pouch" Command="{Binding AddToPouchCommand}" Classes="primary" Name="AddPouchItemButton" ToolTip.Tip="Adds to the first empty slot"/>
                              </Border>
                            </Grid>
                          </TabItem>
                        </TabControl>
                      </Border>
                    </Grid>
                  </TabItem>
                </TabControl>
              </Grid>
              <TextBlock Grid.Row="2" Text="{Binding ItemNamesStatus}" Classes="small inventoryCatalogStatus" Margin="0,10,0,0"/>
            </Grid>
          </Grid>
          <Grid IsVisible="{Binding IsEquipmentSection}">
            <views:EquipmentView/>
          </Grid>
          <views:LoadoutsView IsVisible="{Binding IsLoadoutsSection}"/>
          <views:PalicoesView IsVisible="{Binding IsPalicoesSection}"/>
          <views:MonstersView IsVisible="{Binding IsMonstersSection}"/>
          <Grid IsVisible="{Binding IsQuestsSection}">
            <Grid RowDefinitions="Auto,*">
              <StackPanel>
                <StackPanel Spacing="5" Margin="0,0,0,18">
                  <TextBlock Text="04 / QUEST JOURNAL" Classes="eyebrow" FontSize="10"/>
                  <TextBlock Text="Quest progress" Classes="pageTitle" TextWrapping="Wrap"/>
                  <TextBlock Text="Find quests and manage completion flags for this character." Classes="muted pageDescription" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
              <Grid Grid.Row="1" ColumnDefinitions="*,20,340">
                <Grid RowDefinitions="Auto,*">
                  <Grid ColumnDefinitions="*,160" Margin="0,0,0,12">
                    <TextBox Text="{Binding QuestFilter, Mode=TwoWay}" PlaceholderText="Search quest name or index…" Name="QuestFilterInput"/>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                      <ComboBox ItemsSource="{Binding QuestCategories}" SelectedItem="{Binding QuestCategory, Mode=TwoWay}" HorizontalAlignment="Stretch" Name="QuestCategoryPicker"/>
                    </StackPanel>
                  </Grid>
                  <ListBox Grid.Row="1" ItemsSource="{Binding QuestView}" SelectedItem="{Binding SelectedQuest, Mode=TwoWay}" Classes="records">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:QuestRow">
                        <Grid ColumnDefinitions="28,Auto,*" Margin="4,3">
                          <views:GameIcon Key="ui:quests" Width="22" Height="22" VerticalAlignment="Center"/>
                          <CheckBox Grid.Column="1" IsChecked="{Binding IsCleared, Mode=TwoWay}" Margin="0,0,12,0" ToolTip.Tip="Mark quest cleared"/>
                          <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                              <TextBlock Text="{Binding Category}" Classes="small"/>
                              <TextBlock Text="{Binding Rank, StringFormat='★ {0}'}" Classes="small"/>
                              <TextBlock Text="{Binding Index, StringFormat='#{0}'}" Classes="small"/>
                            </StackPanel>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
                <ScrollViewer Grid.Column="2">
                  <StackPanel Spacing="16">
                    <Border Classes="card">
                      <StackPanel>
                        <StackPanel Spacing="10">
                          <TextBlock Text="Selected quest" Classes="section" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding QuestStatus}" Classes="muted" TextWrapping="Wrap"/>
                          <Button Content="Mark cleared" Command="{Binding ClearSelectedQuestCommand}" Classes="primary" IsEnabled="{Binding HasQuestSelection}"/>
                          <Button Content="Mark not cleared" Command="{Binding UnclearSelectedQuestCommand}" Classes="secondary" IsEnabled="{Binding HasQuestSelection}"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Border Classes="card">
                      <StackPanel>
                        <StackPanel Spacing="10">
                          <TextBlock Text="Filtered quests" Classes="section" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding QuestView.Count, StringFormat=Shown quests: {0}}" Classes="muted" TextWrapping="Wrap"/>
                          <Button Content="Mark shown quests cleared" Command="{Binding ClearVisibleQuestsCommand}" Classes="secondary"/>
                          <Button Content="Reset shown quest flags" Command="{Binding UnclearVisibleQuestsCommand}" Classes="secondary"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Border Classes="card">
                      <StackPanel>
                        <StackPanel Spacing="10">
                          <TextBlock Text="All quest flags" Classes="section" TextWrapping="Wrap"/>
                          <Button Content="Mark all cleared and seen" Command="{Binding MarkAllQuestsClearedCommand}" Classes="secondary"/>
                          <Button Content="Mark all seen" Command="{Binding MarkAllQuestsSeenCommand}" Classes="secondary"/>
                          <Button Content="Complete all quest sets" Command="{Binding CompleteAllQuestSetsCommand}" Classes="secondary"/>
                          <StackPanel Spacing="6">
                            <TextBlock Text="Courier quest counter" Classes="label" TextWrapping="Wrap"/>
                            <views:IntegerInput Value="{Binding QuestCounter, Mode=TwoWay}" Minimum="0" Maximum="4294967295" Increment="1" FormatString="0" Name="QuestCounterInput"/>
                          </StackPanel>
                          <TextBlock Text="The Courier counts repeat eligible hunts, excluding Harvest Tours and Training. Flags and prerequisites are separate." Classes="muted" TextWrapping="Wrap"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Grid>
          </Grid>
          <Grid IsVisible="{Binding IsUnlocksSection}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="0" HorizontalAlignment="Stretch">
                <StackPanel Spacing="5" Margin="0,0,0,18">
                  <TextBlock Text="05 / COLLECTIONS" Classes="eyebrow" FontSize="10"/>
                  <TextBlock Text="Unlocks &amp; rewards" Classes="pageTitle" TextWrapping="Wrap"/>
                  <TextBlock Text="Apply collection unlocks to the selected character." Classes="muted pageDescription" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Classes="inset" Margin="0,0,0,24" Padding="18,14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="COLLECTION RECORD" Classes="eyebrow" FontSize="10"/>
                    <TextBlock Text="{Binding UnlockLine}" Classes="muted" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Grid ColumnDefinitions="*,20,*,20,*">
                  <Border Classes="card">
                    <Grid RowDefinitions="Auto,*,Auto" MinHeight="244">
                      <StackPanel Spacing="16">
                        <TextBlock Text="01 / SMITHY" Classes="eyebrow" FontSize="10"/>
                        <TextBlock Text="Material knowledge" Classes="section" TextWrapping="Wrap"/>
                      </StackPanel>
                      <TextBlock Grid.Row="1" Text="Reveal obtained materials to the Smithy, shops, Trader, and Palico smithy. This does not add items to your inventory." Classes="muted" TextWrapping="Wrap" Margin="0,16,0,24"/>
                      <Button Grid.Row="2" Content="Unlock all materials" Command="{Binding UnlockAllMaterialsCommand}" HorizontalAlignment="Stretch"/>
                    </Grid>
                  </Border>
                  <Border Grid.Column="2" Classes="card">
                    <Grid RowDefinitions="Auto,*,Auto" MinHeight="244">
                      <StackPanel Spacing="16">
                        <TextBlock Text="02 / GUILD CARD" Classes="eyebrow" FontSize="10"/>
                        <TextBlock Text="Guild Card awards" Classes="section" TextWrapping="Wrap"/>
                      </StackPanel>
                      <TextBlock Grid.Row="1" Text="Celebrate every milestone. Grant all 132 award flags for the selected hunter’s Guild Card." Classes="muted" TextWrapping="Wrap" Margin="0,16,0,24"/>
                      <Button Grid.Row="2" Content="Grant all awards" Command="{Binding GrantAllAwardsCommand}" HorizontalAlignment="Stretch"/>
                    </Grid>
                  </Border>
                  <Border Grid.Column="4" Classes="card">
                    <Grid RowDefinitions="Auto,*,Auto" MinHeight="244">
                      <StackPanel Spacing="16">
                        <TextBlock Text="03 / HUNTING ARTS" Classes="eyebrow" FontSize="10"/>
                        <TextBlock Text="Hunter Arts" Classes="section" TextWrapping="Wrap"/>
                      </StackPanel>
                      <TextBlock Grid.Row="1" Text="Expand your hunting repertoire. Unlock all supported Hunter Art flags for this character." Classes="muted" TextWrapping="Wrap" Margin="0,16,0,24"/>
                      <Button Grid.Row="2" Content="Unlock all Hunter Arts" Command="{Binding UnlockAllArtsCommand}" HorizontalAlignment="Stretch"/>
                    </Grid>
                  </Border>
                </Grid>
                <TextBlock Text="These actions are staged in memory. Use Revert changes before saving to discard them." Classes="muted" TextWrapping="Wrap" Margin="0,20,0,0"/>
                <Border Classes="card" Margin="0,20,0,0">
                  <StackPanel Spacing="14">
                    <TextBlock Text="Individual collection entries" Classes="section"/>
                    <Grid ColumnDefinitions="220,12,*">
                      <ComboBox ItemsSource="{Binding CollectionKinds}" SelectedIndex="{Binding CollectionKind, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                      <TextBox Grid.Column="2" Text="{Binding CollectionQuery, Mode=TwoWay}" PlaceholderText="Search collection names or IDs…"/>
                    </Grid>
                    <ListBox Name="CollectionEntriesList" ItemsSource="{Binding CollectionEntries}" Height="300">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CollectionEntry">
                          <Grid ColumnDefinitions="34,38,*" Margin="2,6">
                            <views:GameIcon Key="{Binding IconKey}" Width="26" Height="26" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding Unlocked, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}"/>
                            <StackPanel Grid.Column="2" Spacing="5">
                              <TextBlock Text="{Binding Name}" Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding RarityLabel}" Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}" Classes="small"/>
                              <TextBlock Text="{Binding Description}" Classes="small" TextWrapping="Wrap"/>
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Checking or clearing an entry stages that individual unlock. Award edits update both game and Guild Card maps." Classes="small" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
        <Border IsVisible="{Binding !IsLoaded}" Classes="card" Padding="0" ClipToBounds="True" VerticalAlignment="Center" MaxWidth="1000" HorizontalAlignment="Stretch" BorderBrush="#605640">
          <Grid RowDefinitions="3,*,Auto">
            <Border>
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Color="#C86E55" Offset="0"/>
                  <GradientStop Color="#D8B976" Offset="0.45"/>
                  <GradientStop Color="#8AC6D4" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Grid Grid.Row="1" ColumnDefinitions="*,220" Margin="36,36,28,36">
              <StackPanel Spacing="18" VerticalAlignment="Center">
                <TextBlock Text="PREPARE FOR THE NEXT HUNT" Classes="eyebrow"/>
                <TextBlock Text="Every great hunt
begins with preparation." FontSize="36" LineHeight="44" FontWeight="SemiBold" LetterSpacing="-1" TextWrapping="Wrap"/>
                <TextBlock Text="Your hunter, your loadout, your next adventure. Manage your MHGU save in one organized workspace." Classes="muted" TextWrapping="Wrap" MaxWidth="470" HorizontalAlignment="Left"/>
                <Button Content="Open your save file  →" Click="OnOpenClick" Classes="primary" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                <TextBlock Text="Choose system or system_backup · MHGU for Nintendo Switch" Classes="small" TextWrapping="Wrap"/>
              </StackPanel>
              <views:GuildEmblem Grid.Column="1" Width="196" Height="196" VerticalAlignment="Center" Opacity="0.85"/>
            </Grid>
            <Border Grid.Row="2" Background="#111C24" Padding="30,20" BorderBrush="#36444D" BorderThickness="0,1,0,0">
              <Grid ColumnDefinitions="*,24,*">
                <StackPanel Spacing="6">
                  <TextBlock Text="01  OPEN &amp; EXPLORE" Classes="eyebrow" FontSize="10"/>
                  <TextBlock Text="Select a character. Browse your inventory, gear, and quest progress." Classes="small" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                  <TextBlock Text="02  EDIT &amp; SAVE" Classes="eyebrow" FontSize="10"/>
                  <TextBlock Text="Stage changes, then save. Existing files are backed up automatically." Classes="small" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Column="1" Grid.Row="1" Background="#10191F" BorderBrush="#36444D" BorderThickness="0,1,0,0" Padding="28,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="{Binding SaveState}" Foreground="#8AC6D4" FontSize="12" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Status}" TextWrapping="Wrap" Classes="small" Margin="20,0" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Content="Revert changes" Click="OnRevertClick" IsEnabled="{Binding HasUnsavedChanges}"/>
      </Grid>
    </Border>
  </Grid>
</Window>
